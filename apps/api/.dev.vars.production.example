# Copy this file to .dev.vars.production only when testing the production
# Wrangler environment locally with --env production.
# Do not commit .dev.vars.production.

APP_ENV=production
ANALYTICS_MAX_BATCH_SIZE=50
ADMIN_API_TOKEN=replace-with-production-secret
CORS_ALLOWED_ORIGINS=https://your-account.github.io
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_ANALYTICS_MAX=120
RATE_LIMIT_SCORES_MAX=30
RATE_LIMIT_LEADERBOARD_MAX=60
SCORE_ANTI_FRAUD_WINDOW_SECONDS=300
SCORE_ANTI_FRAUD_MAX_DELTA=100
