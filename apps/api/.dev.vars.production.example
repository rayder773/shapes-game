# Copy this file to .dev.vars.production only when testing the production
# Wrangler environment locally with --env production.
# Do not commit .dev.vars.production.

APP_ENV=production
ANALYTICS_MAX_BATCH_SIZE=50
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
SESSION_TOKEN_PEPPER=replace-with-a-long-random-secret
RATE_LIMIT_SALT=replace-with-a-different-long-random-secret
