# Copy this file to .dev.vars for local Wrangler development.
# Do not commit .dev.vars.

APP_ENV=development
ANALYTICS_MAX_BATCH_SIZE=50
ADMIN_API_TOKEN=local-admin-token
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_ANALYTICS_MAX=120
RATE_LIMIT_SCORES_MAX=30
RATE_LIMIT_LEADERBOARD_MAX=60
SCORE_ANTI_FRAUD_WINDOW_SECONDS=300
SCORE_ANTI_FRAUD_MAX_DELTA=100
