# Copy this file to .dev.vars for local Wrangler development.
# Do not commit .dev.vars.

APP_ENV=development
ANALYTICS_MAX_BATCH_SIZE=50
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
SESSION_TOKEN_PEPPER=replace-with-a-long-random-secret
RATE_LIMIT_SALT=replace-with-a-different-long-random-secret
